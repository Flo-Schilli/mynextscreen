# Database (PostgreSQL)
DATABASE_URL=postgres://signage:signage@localhost:5432/signage

# Postgres container credentials (docker compose) — must match DATABASE_URL above
POSTGRES_USER=signage
POSTGRES_PASSWORD=signage
POSTGRES_DB=signage

# Redis
REDIS_URL=redis://localhost:6379

# Media storage
MEDIA_BASE_PATH=./media

# FFmpeg (default: uses system PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg

# Video transcoding & slicing quality
# CRF: 0 = lossless, 18 = visually lossless, 23 = default, 28 = low quality
# FFMPEG_VIDEO_CRF=18
# Preset: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow
# FFMPEG_VIDEO_PRESET=slow
# Max bitrate cap (prevents spikes on complex scenes)
# FFMPEG_VIDEO_MAXRATE=8M
# Buffer size for rate control (typically 2x maxrate)
# FFMPEG_VIDEO_BUFSIZE=16M

# Internal auth (email + password; JWT access cookie + Redis refresh tokens)
# JWT_ACCESS_SECRET is REQUIRED — generate a strong random value, e.g.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-in-production
# Access/refresh token lifetimes (formats: 90s, 15m, 1h, 30d)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie security. COOKIE_SECURE defaults to true only when NODE_ENV=production.
# Set explicitly (true/false) to override. SameSite: strict (default) | lax | none.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=strict

# Public base URL of the admin SPA — used to build verify/set-password/reset and
# confirm-email-change links inside emails and to lock down CORS (credentials).
# Defaults to http://localhost:4200 in dev.
# PUBLIC_BASE_URL=https://app.example.com

# Player app origin — added to the CORS allowlist so the player (separate origin)
# can call the pairing + screen-auth routes. Defaults to http://localhost:4300 in dev.
# PLAYER_BASE_URL=https://player.example.com

# Platform mailer (account/system emails: verify, invite, reset, email change).
# Independent of per-org SMTP. Defaults target Mailpit in docker compose
# (SMTP on 1025, web UI on http://localhost:8025). Set real SMTP in production.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER and SMTP_PASSWORD are optional — auth is skipped when both are empty.
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=Signage Server <noreply@signage.local>
# TLS from the start (port 465). false = STARTTLS/plain (587/1025).
SMTP_SECURE=false

# Self-signup. When SIGNUP_ENABLED=false, public registration is rejected (403).
SIGNUP_ENABLED=true
# Default storage limits (bytes) granted to a self-created organisation (5 GiB each).
# A super-admin can raise these later.
SIGNUP_DEFAULT_STORAGE_ORIGINAL_BYTES=5368709120
SIGNUP_DEFAULT_STORAGE_TRANSCODED_BYTES=5368709120
# Hours a never-verified signup survives before the cleanup cron deletes it + its org.
SIGNUP_UNVERIFIED_TTL_HOURS=24

# Super-admin: there is no env-based seeding. On a fresh deployment (no user yet)
# the first visitor creates the initial super-admin through the UI first-run setup.
