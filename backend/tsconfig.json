{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "//": "Quarantined specs pending Drizzle re-migration (docs/drizzle-test-migration-todo.md); keep in sync with jest testPathIgnorePatterns.",
  "exclude": [
    "node_modules",
    "dist",
    "src/audit-log/audit-log.controller.spec.ts",
    "src/audit-log/audit-log.service.spec.ts",
    "src/auth/api-key-auth.guard.spec.ts",
    "src/auth/roles.guard.spec.ts",
    "src/content/content-bulk.service.spec.ts",
    "src/content/content.controller.spec.ts",
    "src/content/content.service.spec.ts",
    "src/content/transcoding.processor.spec.ts",
    "src/live-stream/ffmpeg-live.service.spec.ts",
    "src/live-stream/live-stream-activation.service.spec.ts",
    "src/live-stream/live-stream.controller.spec.ts",
    "src/live-stream/live-stream.service.spec.ts",
    "src/live-stream/stream-health.service.spec.ts",
    "src/media/media.controller.spec.ts",
    "src/media/media.service.spec.ts",
    "src/notification/channels/email-notification-channel.service.spec.ts",
    "src/notification/channels/in-app-notification-channel.service.spec.ts",
    "src/notification/channels/ntfy-notification-channel.service.spec.ts",
    "src/notification/notification.controller.spec.ts",
    "src/notification/notification-event-listener.service.spec.ts",
    "src/notification/notification-hub.integration.spec.ts",
    "src/notification/notification-hub.service.spec.ts",
    "src/notification/notification-preferences.controller.spec.ts",
    "src/notification/notification.service.spec.ts",
    "src/notification/org-notification-config.controller.spec.ts",
    "src/notification/org-notification-config.service.spec.ts",
    "src/notification/user-notification-preference.service.spec.ts",
