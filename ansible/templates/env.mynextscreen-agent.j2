# myNextScreen Site Agent — Environment Configuration
# Managed by Ansible — do not edit manually on the server

# Where this agent belongs. Mandatory, and https: the pin is the only thing
# between the agent and a rogue server on the venue LAN, and over plain http it
# would hand its refresh token to whoever answers the name.
MNS_SERVER_URL={{ site_agent_server_url }}
{% if site_agent_allow_insecure_server_url | default(false) | bool %}
# Development only — never set this on a venue host.
MNS_ALLOW_INSECURE_SERVER_URL=true
{% endif %}

{% if site_agent_enrolment_token is defined and site_agent_enrolment_token %}
# One-shot setup code from the dashboard, consulted only while no session is
# stored. It is spent on first boot; re-running this playbook without
# -e site_agent_enrolment_token=... leaves the line out again.
MNS_ENROLMENT_TOKEN={{ site_agent_enrolment_token }}
{% endif %}

# Setup interface on the venue LAN. 0 disables it: an agent enrolled through
# MNS_ENROLMENT_TOKEN has no inbound port at all.
MNS_SETUP_PORT={{ site_agent_setup_port | default(8787) }}

# Session, TV keys and cached configuration. Bind-mounted from the host.
MNS_STATE_DIR=/var/lib/mynextscreen-agent

MNS_LOG_LEVEL={{ site_agent_log_level | default('log') }}
