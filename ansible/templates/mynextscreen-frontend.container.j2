[Unit]
Description=Signage Frontend
After=mynextscreen-backend.service

[Container]
ContainerName=mynextscreen-frontend
Image={{ image_registry }}/frontend:{{ mynextscreen_image_tag }}
AutoUpdate=registry
Pull=newer
Network=mynextscreen.network
# Loopback only: Caddy is the sole public entry point. A 0.0.0.0 port
# would bypass TLS, the security headers and fail2ban.
PublishPort=127.0.0.1:50001:8080
NoNewPrivileges=true
DropCapability=ALL
AddCapability=SETGID
AddCapability=SETUID
EnvironmentFile=%h/.config/containers/systemd/.env.mynextscreen
Environment=BACKEND_UPSTREAM=mynextscreen-backend:3000

[Service]
Restart=always

[Install]
WantedBy=default.target
