# Signage Server Environment Configuration
# Managed by Ansible — do not edit manually on the server

# PostgreSQL connection (backend → signage-postgres container)
DATABASE_URL=postgres://signage:{{ signage_postgres_password }}@signage-postgres:5432/signage

# Media storage path inside the backend container
MEDIA_BASE_PATH=/app/media

# Internal auth (email + password; JWT access cookie + Redis refresh tokens)
NODE_ENV=production
JWT_ACCESS_SECRET={{ jwt_access_secret }}
JWT_ACCESS_TTL={{ jwt_access_ttl | default('15m') }}
JWT_REFRESH_TTL={{ jwt_refresh_ttl | default('30d') }}
COOKIE_SAMESITE={{ cookie_samesite | default('strict') }}

# Public base URL of the admin SPA (verify/set-password/reset/confirm-email links + CORS origin)
PUBLIC_BASE_URL=https://app.{{ domain_name }}

# Platform mailer — account/system emails (verify, invite, reset, email change).
# Independent of per-org SMTP. Set a real SMTP relay in production; auth is skipped
# when SMTP_USER/SMTP_PASSWORD are empty. SMTP_SECURE=true for implicit TLS (465).
SMTP_HOST={{ smtp_host | default('localhost') }}
SMTP_PORT={{ smtp_port | default('587') }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASSWORD={{ smtp_password | default('') }}
SMTP_FROM={{ smtp_from | default('Signage Server <noreply@' ~ domain_name ~ '>') }}
SMTP_SECURE={{ smtp_secure | default('false') }}

# Self-signup. SIGNUP_ENABLED=false rejects public registration (403). Default
# storage limits granted to a self-created org (bytes, 5 GiB each); raise per-org later.
SIGNUP_ENABLED={{ signup_enabled | default('true') }}
SIGNUP_DEFAULT_STORAGE_ORIGINAL_BYTES={{ signup_default_storage_original_bytes | default('5368709120') }}
SIGNUP_DEFAULT_STORAGE_TRANSCODED_BYTES={{ signup_default_storage_transcoded_bytes | default('5368709120') }}
SIGNUP_UNVERIFIED_TTL_HOURS={{ signup_unverified_ttl_hours | default('48') }}

# Super-admin: no env seeding. After deploy, create the first super-admin via the
# UI first-run setup (available only while no user exists).

# Maximum upload file size in bytes (default: 500MB)
MAX_FILE_SIZE_BYTES={{ max_file_size_bytes | default('524288000') }}

# FFmpeg transcoding settings
FFMPEG_VIDEO_CRF={{ ffmpeg_video_crf | default('28') }}
FFMPEG_VIDEO_PRESET={{ ffmpeg_video_preset | default('medium') }}
FFMPEG_VIDEO_MAXRATE={{ ffmpeg_video_maxrate | default('2M') }}
FFMPEG_VIDEO_BUFSIZE={{ ffmpeg_video_bufsize | default('4M') }}

# Strip audio from transcoded videos (true/false)
FFMPEG_VIDEO_STRIP_AUDIO={{ ffmpeg_video_strip_audio | default('false') }}
