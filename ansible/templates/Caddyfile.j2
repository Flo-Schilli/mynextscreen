# myNextScreen — Caddy Reverse Proxy Configuration
# Managed by Ansible — do not edit manually

# ─── Frontend (Admin Panel) ─────────────────────────────────
app.{{ domain_name }} {
	# Prometheus scrape endpoint: internal only (scrape localhost:50002 directly).
	# The frontend's nginx proxies /api/* to the backend, so block it here too.
	handle /api/metrics* {
		respond 404
	}

	# Dashboard SSE stream — disable response buffering so events flush live.
	# Same-origin (app.{domain}/api/*) so the httpOnly access cookie is sent.
	handle /api/dashboard/events {
		reverse_proxy localhost:50001 {
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}

	handle {
		reverse_proxy localhost:50001 {
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		X-Content-Type-Options nosniff
		X-XSS-Protection "1; mode=block"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'"
	}

	log {
		output file /var/log/caddy/app.mynextscreen.access.log {
			roll_size 50MiB
			roll_keep 5
		}
		# The screen API key is accepted as a `token` query parameter, because a
		# browser cannot attach an Authorization header to <img>/<video> src.
		# Without this filter every media request writes a long-lived screen
		# credential into the access log in clear text — and fail2ban reads
		# these files too.
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}
}

# ─── Player (Screen Display) ────────────────────────────────
player.{{ domain_name }} {
	reverse_proxy localhost:50003

	header {
		X-Content-Type-Options nosniff
		X-XSS-Protection "1; mode=block"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Frame-Options
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; connect-src 'self' https://api.{{ domain_name }}; media-src 'self' https://api.{{ domain_name }}; img-src 'self' https://api.{{ domain_name }} data:; style-src 'self' 'unsafe-inline'"
	}

	log {
		output file /var/log/caddy/player.mynextscreen.access.log {
			roll_size 50MiB
			roll_keep 5
		}
		# The screen API key is accepted as a `token` query parameter, because a
		# browser cannot attach an Authorization header to <img>/<video> src.
		# Without this filter every media request writes a long-lived screen
		# credential into the access log in clear text — and fail2ban reads
		# these files too.
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}
}

# ─── API (Backend) ──────────────────────────────────────────
api.{{ domain_name }} {
	# Block API docs in production
	handle /api/docs* {
		respond 404
	}

	# Prometheus scrape endpoint: internal only (scrape localhost:50002 directly)
	handle /api/metrics* {
		respond 404
	}

	# SSE endpoints — disable response buffering
	handle /api/screens/*/events {
		reverse_proxy localhost:50002 {
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}

	# All other API requests
	handle {
		reverse_proxy localhost:50002 {
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		X-Content-Type-Options nosniff
		X-XSS-Protection "1; mode=block"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output file /var/log/caddy/api.mynextscreen.access.log {
			roll_size 50MiB
			roll_keep 5
		}
		# The screen API key is accepted as a `token` query parameter, because a
		# browser cannot attach an Authorization header to <img>/<video> src.
		# Without this filter every media request writes a long-lived screen
		# credential into the access log in clear text — and fail2ban reads
		# these files too.
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}
}
