# Signage Server Environment Configuration
# Copy this file to the quadlets directory on the server and fill in actual values.
# Path on server: ~/.config/containers/systemd/.env.signage

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection (backend → signage-postgres container).
# Password must match the signage-postgres container env (.env.signage-postgres).
DATABASE_URL=postgres://signage:signage@signage-postgres:5432/signage

# ─── Media Storage ──────────────────────────────────────────
# Path inside the backend container for uploaded/transcoded media
MEDIA_BASE_PATH=/app/media

# ─── Authentication (internal email + password) ─────────────
NODE_ENV=production
# REQUIRED: strong random secret for signing access JWTs (openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# strict | lax | none (cookies are secure automatically when NODE_ENV=production)
COOKIE_SAMESITE=strict
# Public base URL of the admin SPA (verify/set-password/reset/confirm-email links + CORS origin)
PUBLIC_BASE_URL=https://app.your-domain.example

# Player app origin — added to the CORS allowlist (pairing + screen-auth requests)
PLAYER_BASE_URL=https://player.your-domain.example

# ─── Platform Mailer (account/system emails) ────────────────
# Verify, invite, password reset, email change, password-changed notice.
# Independent of per-org SMTP. Auth is skipped when USER/PASSWORD are empty.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Signage Server <noreply@your-domain.example>
# true for implicit TLS (port 465); false for STARTTLS/plain (587)
SMTP_SECURE=false

# ─── Self-signup ────────────────────────────────────────────
# false rejects public registration (403).
SIGNUP_ENABLED=true
# Default storage limits granted to a self-created org (bytes, 5 GiB each).
SIGNUP_DEFAULT_STORAGE_ORIGINAL_BYTES=5368709120
SIGNUP_DEFAULT_STORAGE_TRANSCODED_BYTES=5368709120
# Hours a never-verified signup survives before the cleanup cron deletes it + its org.
SIGNUP_UNVERIFIED_TTL_HOURS=24

# Super-admin: no env seeding. After deploy, open the app and create the first
# super-admin via the UI first-run setup (available only while no user exists).

# ─── Upload Limits ──────────────────────────────────────────
# Maximum upload file size in bytes (default: 500 MB)
MAX_FILE_SIZE_BYTES=524288000

# ─── FFmpeg Transcoding ─────────────────────────────────────
# CRF value (0-51): lower = better quality, larger file. 28 is a good default.
FFMPEG_VIDEO_CRF=28

# Encoding speed preset: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow
FFMPEG_VIDEO_PRESET=medium

# Maximum video bitrate
FFMPEG_VIDEO_MAXRATE=2M

# Video buffer size (typically 2x maxrate)
FFMPEG_VIDEO_BUFSIZE=4M
