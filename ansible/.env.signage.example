# Signage Server Environment Configuration
# Copy this file to the quadlets directory on the server and fill in actual values.
# Path on server: ~/.config/containers/systemd/.env.signage

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection (backend → signage-postgres container).
# Password must match the signage-postgres container env (.env.signage-postgres).
DATABASE_URL=postgres://signage:signage@signage-postgres:5432/signage

# ─── Media Storage ──────────────────────────────────────────
# Path inside the backend container for uploaded/transcoded media
MEDIA_BASE_PATH=/app/media

# ─── Authentication (internal email + password) ─────────────
NODE_ENV=production
# REQUIRED: strong random secret for signing access JWTs (openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# strict | lax | none (cookies are secure automatically when NODE_ENV=production)
COOKIE_SAMESITE=strict
# Public base URL of the admin SPA (set-password/reset links + CORS origin)
PUBLIC_BASE_URL=https://app.your-domain.example

# Super-admin seeding — comma-separated emails created on boot. With an initial
# password they can log in immediately; without one they activate via /set-password.
SUPER_ADMIN_EMAILS=
SUPER_ADMIN_INITIAL_PASSWORD=

# ─── Upload Limits ──────────────────────────────────────────
# Maximum upload file size in bytes (default: 500 MB)
MAX_FILE_SIZE_BYTES=524288000

# ─── FFmpeg Transcoding ─────────────────────────────────────
# CRF value (0-51): lower = better quality, larger file. 28 is a good default.
FFMPEG_VIDEO_CRF=28

# Encoding speed preset: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow
FFMPEG_VIDEO_PRESET=medium

# Maximum video bitrate
FFMPEG_VIDEO_MAXRATE=2M

# Video buffer size (typically 2x maxrate)
FFMPEG_VIDEO_BUFSIZE=4M
