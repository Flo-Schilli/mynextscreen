# Signage Server Environment Configuration
# Copy this file to the quadlets directory on the server and fill in actual values.
# Path on server: ~/.config/containers/systemd/.env.signage

# ─── Database ───────────────────────────────────────────────
# Path inside the backend container where SQLite DB is stored
DATABASE_PATH=/app/data/signage.db

# ─── Media Storage ──────────────────────────────────────────
# Path inside the backend container for uploaded/transcoded media
MEDIA_BASE_PATH=/app/media

# ─── Authentication (Hanko) ─────────────────────────────────
# Hanko API URL — used by both backend (token verification) and frontend (login UI)
HANKO_API_URL=https://your-project.hanko.io

# Comma-separated Hanko user IDs that have super admin privileges
# Find these in the Hanko dashboard after users sign up
SUPER_ADMIN_USER_IDS=

# ─── Upload Limits ──────────────────────────────────────────
# Maximum upload file size in bytes (default: 500 MB)
MAX_FILE_SIZE_BYTES=524288000

# ─── FFmpeg Transcoding ─────────────────────────────────────
# CRF value (0-51): lower = better quality, larger file. 28 is a good default.
FFMPEG_VIDEO_CRF=28

# Encoding speed preset: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow
FFMPEG_VIDEO_PRESET=medium

# Maximum video bitrate
FFMPEG_VIDEO_MAXRATE=2M

# Video buffer size (typically 2x maxrate)
FFMPEG_VIDEO_BUFSIZE=4M
