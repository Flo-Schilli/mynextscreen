# Signage Server Environment Configuration
# Copy this file and fill in actual values before deployment.

# Database path inside the backend container
DATABASE_PATH=/app/data/signage.db

# Media storage path inside the backend container
MEDIA_BASE_PATH=/app/media

# Hanko authentication API URL
HANKO_API_URL=https://hanko.example.com

# Comma-separated Hanko user IDs with super admin privileges
SUPER_ADMIN_USER_IDS=

# Maximum upload file size in bytes (default: 500MB)
MAX_FILE_SIZE_BYTES=524288000

# FFmpeg transcoding settings
FFMPEG_VIDEO_CRF=28
FFMPEG_VIDEO_PRESET=medium
FFMPEG_VIDEO_MAXRATE=2M
FFMPEG_VIDEO_BUFSIZE=4M
