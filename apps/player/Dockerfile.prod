# Build context = repo root (Nx monorepo: one root package.json + lockfile).
# Build:  docker build -f apps/player/Dockerfile.prod -t signage-player .

# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json nx.json tsconfig.base.json ./
RUN npm ci

COPY apps/player apps/player
COPY libs libs

RUN npx nx build player --configuration=production

# Stage 2: Production runtime
FROM nginx:alpine

# Build metadata (passed by CI / images:build) -> OCI labels + version.json
ARG APP_VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="signage-player" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/Flo-Schilli/digital-signage"

COPY apps/player/nginx.prod.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist/apps/player/browser /usr/share/nginx/html

# Runtime-discoverable build metadata
RUN printf '{"version":"%s","commit":"%s","builtAt":"%s"}\n' \
      "${APP_VERSION}" "${GIT_COMMIT}" "${BUILD_DATE}" \
      > /usr/share/nginx/html/version.json

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
