# Build context = repo root (Nx monorepo: one root package.json + lockfile).
# Build:  docker build -f apps/frontend/Dockerfile.prod -t mynextscreen-frontend .

# Stage 1: Build
FROM node:25-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json nx.json tsconfig.base.json ./
# The lockfile is maintained with the npm version pinned in package.json;
# the base image's bundled npm can lag that patch, so pin it explicitly to keep
# `npm ci` deterministic (older npm fails with "Missing: ... from lock file").
RUN npm i -g npm@11.6.2
RUN npm ci

COPY apps/frontend apps/frontend
COPY libs libs

RUN npx nx build frontend --configuration=production

# Stage 2: Production runtime
# Unprivileged variant: runs as UID 101 and listens on 8080, so the container
# does not need root just to serve static files.
FROM nginxinc/nginx-unprivileged:1.31-alpine

# The base image already switches to UID 101; the build steps below need to
# write into /etc/nginx and /usr/share/nginx, so they run as root and the
# runtime user is restored before the entrypoint.
USER root

# Pull the current Alpine package set: the base image tag is rebuilt less often
# than its packages are fixed, and the CI image scan gates on exactly these.
# Changes daily (CI passes the build date), so the layer below is re-resolved
# instead of replayed from the buildx cache. Without it the cached layer keeps
# whatever package set existed when it was first built, and the Trivy gate then
# fails on advisories Alpine has already shipped a fix for.
ARG ALPINE_REFRESH=unset
RUN echo "alpine package refresh: ${ALPINE_REFRESH}" \
    && apk upgrade --no-cache

RUN apk add --no-cache gettext

# Build metadata (passed by CI / images:build) -> OCI labels + version.json
ARG APP_VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="mynextscreen-frontend" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/Flo-Schilli/mynextscreen"

# nginx template (envsubst BACKEND_UPSTREAM at runtime) + entrypoint
COPY apps/frontend/nginx.prod.conf.template /etc/nginx/templates/default.conf.template
COPY apps/frontend/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

COPY --from=builder /app/dist/apps/frontend/browser /usr/share/nginx/html

# Runtime-discoverable build metadata
RUN printf '{"version":"%s","commit":"%s","builtAt":"%s"}\n' \
      "${APP_VERSION}" "${GIT_COMMIT}" "${BUILD_DATE}" \
      > /usr/share/nginx/html/version.json

USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
