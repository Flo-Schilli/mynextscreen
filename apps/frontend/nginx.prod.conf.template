log_format api_noquery '$remote_addr - $remote_user [$time_local] '
                        '"$request_method $uri $server_protocol" $status '
                        '$body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API proxy — must come before SPA/static rules (^~ wins against regex)
    location ^~ /api/ {
        # $uri instead of $request: the screen API key travels as a `token`
        # query parameter on media URLs (a browser cannot set an Authorization
        # header on <img>/<video> src), and the default log line would write
        # that long-lived credential to disk on every frame request.
        access_log /var/log/nginx/access.log api_noquery;
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Keep Caddy's client IP instead of overwriting it with nginx's own
        # address — the backend rate limiter keys on this header, and on this
        # path the request has already passed through Caddy.
        set $client_real_ip $remote_addr;
        if ($http_x_real_ip) {
            set $client_real_ip $http_x_real_ip;
        }
        proxy_set_header X-Real-IP $client_real_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";          # keep-alive to upstream
        # SSE (dashboard events) + general API: stream, never buffer
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;                   # long-lived SSE connections
        # Large uploads (/api/content/upload)
        client_max_body_size ${MAX_UPLOAD_SIZE}; # keep >= backend MAX_FILE_SIZE_BYTES
        proxy_request_buffering off;
    }

    # Build metadata — never cache
    location = /version.json {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # SPA routing — serve index.html for all non-file routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets aggressively (Angular hashes filenames)
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp|avif)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Block hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
