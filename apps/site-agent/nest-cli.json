{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "allowOutsidePaths": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "setup/public/**/*",
        "outDir": "../../dist/apps/site-agent",
        "watchAssets": true
      }
    ]
  }
}
