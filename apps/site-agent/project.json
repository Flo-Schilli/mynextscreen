{
  "name": "site-agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/site-agent/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/site-agent"],
      "options": {
        "command": "nest build",
        "cwd": "apps/site-agent"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest start --watch",
        "cwd": "apps/site-agent"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "cwd": "apps/site-agent"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/site-agent"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"src/**/*.ts\"",
        "cwd": "apps/site-agent"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"src/**/*.ts\"",
        "cwd": "apps/site-agent"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check \"src/**/*.ts\"",
        "cwd": "apps/site-agent"
      }
    }
  }
}
