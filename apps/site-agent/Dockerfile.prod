# Build context = repo root (Nx monorepo: one root package.json + lockfile).
# Build:  docker build -f apps/site-agent/Dockerfile.prod -t mynextscreen-site-agent .

# Stage 1: Build
FROM node:26-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json nx.json tsconfig.base.json ./
# The lockfile is maintained with the npm version pinned in package.json;
# the base image's bundled npm can lag that patch, so pin it explicitly.
RUN npm i -g npm@11.6.2
RUN npm ci

COPY apps/site-agent apps/site-agent
COPY libs libs

RUN npx nx build site-agent

# Stage 2: Production runtime
FROM node:26-alpine

# Pull the current Alpine package set: the base image tag is rebuilt less often
# than its packages are fixed, and the CI image scan gates on exactly these.
# Changes daily (CI passes the build date), so the layer below is re-resolved
# instead of replayed from the buildx cache. Without it the cached layer keeps
# whatever package set existed when it was first built, and the Trivy gate then
# fails on advisories Alpine has already shipped a fix for.
ARG ALPINE_REFRESH=unset
RUN echo "alpine package refresh: ${ALPINE_REFRESH}" \
    && apk upgrade --no-cache

# tini as PID 1 for clean signal handling. Deliberately no openssh-client: the
# agent speaks SSH through the `ssh2` library, which also means the host's
# OpenSSL crypto policy cannot break it against a TV's OpenSSH 6.1.
#
# iw reads the Wi-Fi network name over nl80211 for the dashboard. It needs no
# capability, so it works under DropCapability=ALL with host networking.
RUN apk add --no-cache tini iw

WORKDIR /app

COPY package.json package-lock.json ./
# npm is a build-time tool only — the container runs `node dist/...`. Removing
# it drops the advisories Trivy reports against npm's own bundled dependencies.
RUN npm i -g npm@11.6.2 \
    && npm ci --omit=dev \
    && npm cache clean --force \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

COPY --from=builder --chown=node:node /app/dist/apps/site-agent ./dist/apps/site-agent

ARG APP_VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ENV APP_VERSION=${APP_VERSION} \
    GIT_COMMIT=${GIT_COMMIT} \
    BUILD_DATE=${BUILD_DATE}
LABEL org.opencontainers.image.title="mynextscreen-site-agent" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/Flo-Schilli/mynextscreen"

# The state directory holds one tenant's credential, the TVs' encrypted keys and
# their Developer Mode passphrases. Owned by the unprivileged user the agent
# runs as, and bind-mounted from the host in production.
RUN mkdir -p /var/lib/mynextscreen-agent \
    && chown node:node /var/lib/mynextscreen-agent \
    && chmod 700 /var/lib/mynextscreen-agent
VOLUME ["/var/lib/mynextscreen-agent"]

USER node

# The setup interface. Wake-on-LAN needs host networking anyway, so this is
# published on the venue LAN rather than mapped.
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/api/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/apps/site-agent/main.js"]
