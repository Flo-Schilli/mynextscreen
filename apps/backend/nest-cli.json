{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "allowOutsidePaths": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "db/migrations/**/*.sql",
        "outDir": "../../dist/apps/backend",
        "watchAssets": true
      },
      {
        "include": "db/migrations/meta/**/*.json",
        "outDir": "../../dist/apps/backend",
        "watchAssets": true
      }
    ]
  }
}
