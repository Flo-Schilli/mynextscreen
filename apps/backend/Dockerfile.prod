# Build context = repo root (Nx monorepo: one root package.json + lockfile).
# Build:  docker build -f apps/backend/Dockerfile.prod -t signage-backend .

# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json nx.json tsconfig.base.json ./
RUN npm ci

COPY apps/backend apps/backend
COPY libs libs

# Backend has no Nx "production" configuration — plain build target (nest build).
# Emits dist/apps/backend/main.js + db/migrations/*.sql (nest-cli assets config).
RUN npx nx build backend

# Stage 2: Production runtime
FROM node:22-alpine

# ffmpeg for transcoding + live streaming; tini as PID 1 for clean signal handling
RUN apk add --no-cache ffmpeg tini

WORKDIR /app

# Production deps resolved against the single root lockfile
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Compiled output incl. db/migrations/*.sql (run automatically on boot)
COPY --from=builder /app/dist/apps/backend ./dist/apps/backend

# Build metadata (passed by CI / images:build) -> runtime ENV + OCI labels
ARG APP_VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ENV APP_VERSION=${APP_VERSION} \
    GIT_COMMIT=${GIT_COMMIT} \
    BUILD_DATE=${BUILD_DATE}
LABEL org.opencontainers.image.title="signage-backend" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/Flo-Schilli/digital-signage"

EXPOSE 3000

# Drizzle migrations run automatically on boot via migrate() in main.ts
# (the .sql files in dist/apps/backend/db/migrations are copied as nest-cli assets).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/apps/backend/main.js"]
