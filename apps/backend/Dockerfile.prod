# Build context = repo root (Nx monorepo: one root package.json + lockfile).
# Build:  docker build -f apps/backend/Dockerfile.prod -t mynextscreen-backend .

# Stage 1: Build
FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json nx.json tsconfig.base.json ./
# The lockfile is maintained with the npm version pinned in package.json;
# the base image's bundled npm can lag that patch, so pin it explicitly to keep
# `npm ci` deterministic (older npm fails with "Missing: ... from lock file").
RUN npm i -g npm@11.6.2
RUN npm ci

COPY apps/backend apps/backend
COPY libs libs

# Backend has no Nx "production" configuration — plain build target (nest build).
# Emits dist/apps/backend/main.js + db/migrations/*.sql (nest-cli assets config).
RUN npx nx build backend

# Stage 2: Production runtime
FROM node:24-alpine

# Pull the current Alpine package set: the base image tag is rebuilt less often
# than its packages are fixed, and the CI image scan gates on exactly these.
# Changes daily (CI passes the build date), so the layer below is re-resolved
# instead of replayed from the buildx cache. Without it the cached layer keeps
# whatever package set existed when it was first built, and the Trivy gate then
# fails on advisories Alpine has already shipped a fix for.
ARG ALPINE_REFRESH=unset
RUN echo "alpine package refresh: ${ALPINE_REFRESH}" \
    && apk upgrade --no-cache

# ffmpeg for transcoding + live streaming; tini as PID 1 for clean signal handling
RUN apk add --no-cache ffmpeg tini

WORKDIR /app

# Production deps resolved against the single root lockfile
COPY package.json package-lock.json ./
# npm is a build-time tool only — the container runs `node dist/...`. Removing it
# again drops ~30 advisories that Trivy reports against npm's own bundled
# dependencies and that no runtime code can reach.
RUN npm i -g npm@11.6.2 \
    && npm ci --omit=dev \
    && npm cache clean --force \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

# Compiled output incl. db/migrations/*.sql (run automatically on boot)
COPY --from=builder --chown=node:node /app/dist/apps/backend ./dist/apps/backend

# Player-app guides (Markdown) and pre-built binaries (IPK)
COPY --chown=node:node player-applications ./player-applications

# Build metadata (passed by CI / images:build) -> runtime ENV + OCI labels
ARG APP_VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ENV APP_VERSION=${APP_VERSION} \
    GIT_COMMIT=${GIT_COMMIT} \
    BUILD_DATE=${BUILD_DATE}
LABEL org.opencontainers.image.title="mynextscreen-backend" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/Flo-Schilli/mynextscreen"

# Drop root. FFmpeg parses user-uploaded media in this container, so a parser
# bug would otherwise be root — the same reason the two nginx images moved to an
# unprivileged user. `node` (uid 1000) ships with the base image; /tmp, where the
# HLS segments go, is world-writable, and the media bind mount is made writable
# by mapping this uid back to the host account in the quadlet
# (`UserNS=keep-id:uid=1000,gid=1000`).
USER node

EXPOSE 3000

# Drizzle migrations run automatically on boot via migrate() in main.ts
# (the .sql files in dist/apps/backend/db/migrations are copied as nest-cli assets).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/apps/backend/main.js"]
