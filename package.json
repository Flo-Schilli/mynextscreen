{
  "name": "mynextscreen",
  "version": "0.30.0",
  "description": "Multi-tenant digital signage platform",
  "license": "AGPL-3.0-or-later",
  "author": "Florian Schillhammer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flo-Schilli/mynextscreen.git"
  },
  "homepage": "https://github.com/Flo-Schilli/mynextscreen",
  "bugs": {
    "url": "https://github.com/Flo-Schilli/mynextscreen/issues"
  },
  "private": true,
  "engines": {
    "node": "26.x",
    "npm": "12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "docker compose up --build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "format": "nx run-many -t format",
    "format:check": "nx run-many -t format:check",
    "version": "node scripts/sync-versions.mjs && git add package-lock.json player-applications/lg-tvos/appinfo.json",
    "version:patch": "npm version patch -m \"chore(release): %s\"",
    "version:minor": "npm version minor -m \"chore(release): %s\"",
    "version:major": "npm version major -m \"chore(release): %s\"",
    "images:build": "APP_VERSION=$(node -p \"require('./package.json').version\") GIT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo unknown) BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) ./scripts/build-images.sh"
  },
