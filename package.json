{
  "name": "signage-server",
  "version": "0.1.0",
  "description": "Multi-tenant digital signage platform",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "docker compose up --build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "format": "nx run-many -t format",
    "format:check": "nx run-many -t format:check",
    "version": "node scripts/sync-versions.mjs && git add package-lock.json",
    "version:patch": "npm version patch -m \"chore(release): %s\"",
    "version:minor": "npm version minor -m \"chore(release): %s\"",
    "version:major": "npm version major -m \"chore(release): %s\"",
    "images:build": "APP_VERSION=$(node -p \"require('./package.json').version\") GIT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo unknown) BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) ./scripts/build-images.sh"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.4",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.6",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@tailwindcss/postcss": "^4.2.2",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "hls.js": "^1.6.15",
    "ioredis": "^5.11.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.21.0",
    "postcss": "^8.5.8",
    "reflect-metadata": "^0.2.0",
    "rrule": "^2.8.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.3.1",
    "@analogjs/vitest-angular": "2.3.1",
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.17",
    "@nx/angular": "22.7.5",
    "@nx/eslint": "22.7.5",
    "@nx/jest": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/vite": "22.7.5",
    "@nx/webpack": "22.7.5",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "angular-eslint": "21.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.3.0",
    "jsdom": "^29.0.1",
    "nx": "22.7.5",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.0.0",
    "tsconfig-paths": "^4.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.1.2",
    "zone.js": "^0.16.1"
  }
}
